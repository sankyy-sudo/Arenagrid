DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/arenagrid?schema=public"
PORT=4000
APP_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string-min-24-chars
ADMIN_SESSION_MINUTES=60
MEDIA_STORAGE_PATH=./uploads
MEDIA_MAX_FILE_MB=10
NODE_ENV=development
# Leave 0 locally. Set to your known reverse proxy count on deployment.
TRUST_PROXY_HOPS=0
# Optional: absolute backend admin URL for separate hosting (same-origin is recommended).
VITE_API_BASE_URL=/api/admin
# Optional: Vite development proxy target; otherwise uses PORT above.
# API_PROXY_TARGET=http://localhost:4000
# Optional public production origin for absolute social-card URLs (no trailing path).
# Leave unset until the real domain is known, then rebuild. This is not a secret.
# VITE_SITE_URL=https://your-domain.example
# Seed only: set explicitly to create demo users. Never used by the running API.
SEED_ADMIN_PASSWORD=
